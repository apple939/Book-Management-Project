<h4 class="mb-3"><i class="bi bi-journal-text"></i> 借阅记录</h4>

<div class="card mb-3">
  <div class="card-body">
    <form class="row g-2" method="GET">
      <div class="col-auto">
        <select name="status" class="form-select">
          <option value="">全部状态</option>
          <option value="borrowed" <%= status === 'borrowed' ? 'selected' : '' %>>借阅中</option>
          <option value="returned" <%= status === 'returned' ? 'selected' : '' %>>已归还</option>
        </select>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary">筛选</button>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>#</th><th>书名</th><th>ISBN</th>
          <% if (user.role === 'admin') { %><th>借阅人</th><% } %>
          <th>借阅日期</th><th>应还日期</th><th>归还日期</th><th>状态</th><th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% records.forEach(function(r) { %>
        <tr>
          <td><%= r.id %></td>
          <td><%= r.book_title %></td>
          <td><%= r.isbn || '-' %></td>
          <% if (user.role === 'admin') { %>
          <td><%= r.realname || r.username %></td>
          <% } %>
          <td><%= r.borrow_date ? r.borrow_date.substring(0, 10) : '-' %></td>
          <td><%= r.due_date ? r.due_date.substring(0, 10) : '-' %></td>
          <td><%= r.return_date ? r.return_date.substring(0, 10) : '-' %></td>
          <td>
            <% if (r.status === 'borrowed') { %>
            <% if (new Date(r.due_date) < new Date()) { %>
            <span class="badge bg-danger">已逾期</span>
            <% } else { %>
            <span class="badge bg-warning text-dark">借阅中</span>
            <% } %>
            <% } else { %>
            <span class="badge bg-success">已归还</span>
            <% } %>
          </td>
          <td>
            <% if (r.status === 'borrowed') { %>
            <button class="btn btn-sm btn-success" onclick="returnBook(<%= r.id %>)">归还</button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (totalPages > 1) { %>
<nav class="mt-3">
  <ul class="pagination justify-content-center">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="?page=<%= page-1 %>&status=<%= status %>">上一页</a>
    </li>
    <% for (let i = 1; i <= totalPages; i++) { %>
    <li class="page-item <%= i === page ? 'active' : '' %>">
      <a class="page-link" href="?page=<%= i %>&status=<%= status %>"><%= i %></a>
    </li>
    <% } %>
    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
      <a class="page-link" href="?page=<%= page+1 %>&status=<%= status %>">下一页</a>
    </li>
  </ul>
</nav>
<% } %>
